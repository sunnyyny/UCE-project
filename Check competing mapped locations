# How many distinct C. elegans coordinate intervals have more than one reported partner location in C. briggsae:
awk -F '\t' 'NR > 1 {
    e = $2 FS $3 FS $4
    b = $5 FS $6 FS $7
    if (!seen[e, b]++) partners[e]++
}
END {
    for (e in partners)
        if (partners[e] > 1)
            print e, partners[e]
}' data/95_identity_latest/qc/uce95_pairs.tsv \
  | sort -k1,1 -k2,2n \
  > data/95_identity_latest/qc/elegans_multiple_partner_locations.txt

wc -l data/95_identity_latest/qc/elegans_multiple_partner_locations.txt
#output: 37

